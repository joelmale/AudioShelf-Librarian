# AudioShelf Librarian — backend environment
#
# Every variable the backend reads is listed here with its default. All are
# optional unless marked REQUIRED. Most integration settings are also editable
# in the UI under the gear menu and stored in /app/data; the variables below
# take precedence over stored values, and secrets supplied by environment are
# never persisted to disk.

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3050
# Root for settings.json, secrets.json, settings-history.json, history.json, and
# the SQLite database. Back this up before upgrades.
DATA_DIR=/app/data
DB_PATH=/app/data/curator.db
LOG_LEVEL=info
# NODE_ENV=production          # `test` disables the immediate inbox poll

# ── Audiobookshelf ───────────────────────────────────────────────────────────
ABS_URL=http://audiobookshelf:80
ABS_TOKEN=
# Library the encoder rescans after a job completes.
ABS_LIBRARY_ID=
# Set only to pin behaviour against a specific ABS release.
# ABS_COMPAT_VERSION=
# Live ABS socket updates. Off by default.
ABS_SOCKET_ENABLED=false

# ── Authentication (OIDC) ────────────────────────────────────────────────────
# Off by default: with AUTH_ENABLED=false the API is unrestricted and must only
# be reached over a trusted network. Enabling it REQUIRES issuer and audience.
#
# NOTE: the backend enforces auth, but the frontend does not yet attach a token
# to REST calls or the WebSocket, so turning this on currently breaks the UI.
AUTH_ENABLED=false
# OIDC_ISSUER=https://sso.example.com/realms/homelab   # REQUIRED when enabled
# OIDC_AUDIENCE=audioshelf                             # REQUIRED when enabled
# OIDC_JWKS_URI=                 # skips discovery when set
# OIDC_GROUPS_CLAIM=groups
# OIDC_VIEWER_GROUP=audioshelf-viewer
# OIDC_CURATOR_GROUP=audioshelf-curator
# OIDC_LIBRARIAN_GROUP=audioshelf-librarian
# OIDC_ADMIN_GROUP=audioshelf-admin

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Off by default. The secret must be at least 32 characters or every request is
# rejected; it is compared in constant time.
WEBHOOK_ENABLED=false
# ABS_WEBHOOK_SECRET=

# ── Filesystem ───────────────────────────────────────────────────────────────
# Directories the settings path browser may enumerate, separated by the platform
# path delimiter (":" on Linux, ";" on Windows). Defaults to the configured
# library and inbox directories plus /audiobooks, /inbox and /downloads.
# FS_BROWSE_ROOTS=/audiobooks:/inbox:/downloads

# ── LLM providers ────────────────────────────────────────────────────────────
# Cloud. Leave empty to run local-only via Ollama.
ANTHROPIC_API_KEY=
# Model overrides. Defaults are claude-haiku-4-5 for tagging and claude-sonnet-5
# for collection reasoning; these MUST be real Anthropic model IDs.
# TAGGING_MODEL=
# COLLECTION_MODEL=
ANTHROPIC_RPM=50
ANTHROPIC_TPM=40000
# Local fallback.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral-nemo:latest
# Embedding model served by Ollama. Embeddings always run locally against
# OLLAMA_URL — there is no cloud path.
EMBEDDING_MODEL=nomic-embed-text
# cloud-first | local-first
LLM_PRIORITY=cloud-first

# ── Tagging & collections ────────────────────────────────────────────────────
TAGGING_CONCURRENCY=4
TAGGING_BATCH_SIZE=10
# GENERATED_TAG_PREFIX=
# Scheduled auto-curation. Empty installs no cron job at all.
CRON_SCHEDULE=
# When false the scheduler never writes collections back to ABS.
AUTO_PUSH=false

# ── qBittorrent ──────────────────────────────────────────────────────────────
# All three are environment-managed. Anything set here WINS over the value
# stored through the settings UI, and a password supplied this way is never
# written to secrets.json.
QBIT_URL=
# QBITTORRENT_URL is accepted as an alias for QBIT_URL.
QBIT_USER=
QBIT_PASS=

# ── Outbound proxy (used by the AudiobookBay scraper) ────────────────────────
# HTTP_PROXY=
# HTTPS_PROXY=

# ── MCP server ───────────────────────────────────────────────────────────────
# Exposes the curator as MCP tools at POST /mcp on the main port (no second
# listener). Off by default. Inherits authentication from the app; each tool is
# additionally gated at the role its REST equivalent requires.
MCP_ENABLED=false

# ── Encoder ──────────────────────────────────────────────────────────────────
# Encoding is delegated to Audiobookshelf. The variables below are read by
# config.ts but are not consumed anywhere else — they are the remains of a
# local m4b-tool encoder that was never finished. Setting them has no effect.
# ABS_LIBRARY_PATH=
# ENCODE_OUTPUT_PATH=
# ENCODE_BACKUP_PATH=
# M4B_TOOL_PATH=m4b-tool
# FFPROBE_PATH=ffprobe
# ENCODE_CONCURRENCY=1

# ── Node / TypeScript ────────────────────────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
.pnpm-store/
npm-debug.log*
yarn-error.log*

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
config.local.ini

# ── Local model bake-off output ──────────────────────────────────────────────
bench-results/

# ── Application runtime state (mounted at /app/data in production) ───────────
data/
logs/
temp/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Test & coverage output ───────────────────────────────────────────────────
coverage/
htmlcov/
.vitest/

# ── Editors & OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Scratch ──────────────────────────────────────────────────────────────────
*.bak
*.orig
*.tmp
*-dev.log

# NOTE: media and image extensions are deliberately NOT ignored here.
# The previous Python-era gitignore excluded *.svg, *.png, *.jpg and *.ico,
# which silently dropped any frontend asset (a favicon, a logo, an empty-state
# illustration) from every commit with no error. Sample audio fixtures belong
# under an explicitly ignored fixtures directory instead, not a global rule.
